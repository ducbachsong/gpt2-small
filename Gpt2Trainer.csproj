<Project Sdk="Microsoft.NET.Sdk">

  <!-- The LibTorch build comes from TorchBackend:
         dotnet build -c Release                            CPU (any OS, for testing)
         dotnet build -c Release -p:TorchBackend=cuda-linux     Colab / Linux GPU
         dotnet build -c Release -p:TorchBackend=cuda-windows   Windows GPU
       traingpt2cs.py picks it for you. -->
  <PropertyGroup>
    <!-- A library that traingpt2cs.py loads into Python (pythonnet): this also
         writes the runtimeconfig.json .NET needs and copies TorchSharp next to it. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TorchBackend Condition="'$(TorchBackend)' == ''">cpu</TorchBackend>
    <TorchSharpVersion>0.107.0</TorchSharpVersion>
  </PropertyGroup>

  <!-- The code is in src/, and our CUDA kernels in src/cuda/; the tests there
       (src/test) are a project of their own. -->
  <PropertyGroup>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>   <!-- CudaKernel.cs: pointers for cuLaunchKernel -->
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/*.cs;src/cuda/*.cs" />
    <!-- The kernels' CUDA source goes inside the dll, as adamw.cu etc.;
         CudaKernel compiles it for the GPU it runs on. -->
    <EmbeddedResource Include="src/cuda/*.cu" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TorchSharp-cpu" Version="$(TorchSharpVersion)" Condition="'$(TorchBackend)' == 'cpu'" />
    <PackageReference Include="TorchSharp-cuda-linux" Version="$(TorchSharpVersion)" Condition="'$(TorchBackend)' == 'cuda-linux'" />
    <PackageReference Include="TorchSharp-cuda-windows" Version="$(TorchSharpVersion)" Condition="'$(TorchBackend)' == 'cuda-windows'" />
  </ItemGroup>

</Project>
